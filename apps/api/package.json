{
  "name": "@nature/api",
  "version": "0.1.0",
  "private": true,
  "description": "Nature Explorer API: Fastify 5 + TypeBox (OpenAPI), Drizzle ORM (Postgres 16 + PostGIS), pg-boss jobs",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage .turbo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "job:reckoning": "tsx src/jobs/run.ts reckoning.weekly",
    "job:consistency": "tsx src/jobs/run.ts reckoning.consistency",
    "job:autofinish": "tsx src/jobs/run.ts walk.autofinish",
    "job:purge-samples": "tsx src/jobs/run.ts samples.purge",
    "openapi:print": "tsx src/openapi/print.ts",
    "dev:apple-stub": "tsx scripts/apple-stub.ts",
    "job:purge": "tsx src/jobs/run.ts account.purge",
    "job:export": "tsx src/jobs/run.ts account.export"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@nature/territory-rules": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.3",
    "fastify-plugin": "^5.1.0",
    "h3-js": "^4.5.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pg-boss": "^10.4.2",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@nature/h3-fixtures": "workspace:*",
    "@nature/walk-sim": "workspace:*",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
