# Copy to apps/api/.env for local development (the API reads process.env; `make dev` exports
# DATABASE_URL itself). Values match infra/docker-compose.yml.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://nature:nature@localhost:5432/nature
LOG_LEVEL=info
# Set to false to boot the API without pg-boss (no scheduled jobs).
JOBS_ENABLED=true
# Set to true only behind a reverse proxy that sets x-forwarded-for (feature 009: Caddy).
TRUST_PROXY=false

# Sessions (specs/002-auth-and-factions/data-model.md §7). Generate a real secret per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-secret-dev-secret-dev-secret-0123
JWT_ACCESS_TTL_S=900
REFRESH_TTL_DAYS=60
# Sign in with Apple: accepted audiences (bundle ids, comma-separated) and the key service.
# TODO(owner): replace the placeholder bundle id once the App ID exists.
APPLE_CLIENT_IDS=com.natureexplorer.app
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# For local testing without an Apple account: `pnpm --filter @nature/api dev:apple-stub` and
# APPLE_JWKS_URL=http://localhost:4567/keys
AUTH_RATE_LIMIT_PER_MIN=20

# Account lifecycle
ACCOUNT_PURGE_GRACE_DAYS=30
EXPORT_TTL_DAYS=7
EXPORT_URL_TTL_S=3600

# Object storage (MinIO locally, Hetzner Object Storage in production)
S3_ENDPOINT=http://localhost:9000
# Endpoint written into presigned URLs when clients cannot reach S3_ENDPOINT (e.g. a phone on the LAN).
# S3_PUBLIC_ENDPOINT=http://192.168.1.10:9000
S3_REGION=eu-central-1
S3_BUCKET=nature-media
S3_ACCESS_KEY=nature
S3_SECRET_KEY=naturenature
