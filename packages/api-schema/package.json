{
  "name": "@nature/api-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Committed snapshot of the Nature Explorer API's generated OpenAPI document (the contract the iOS client is generated from) and the script/test that keep it current",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage .turbo",
    "snapshot": "tsx scripts/snapshot.ts"
  },
  "devDependencies": {
    "@nature/api": "workspace:*",
    "@types/node": "^22.15.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
