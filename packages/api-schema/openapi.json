{
  "openapi": "3.1.0",
  "info": {
    "title": "Nature Explorer API",
    "version": "0.1.0",
    "description": "Generated at startup from the TypeBox schemas of the registered routes. Every non-2xx response uses the shared `Error` schema and echoes the request id in `x-request-id`. `/v1/me*`, `/v1/walks*` and `/v1/auth/logout` need a bearer access token (`bearerAuth`). Walk scoring happens only in POST /v1/walks/{id}/finish (docs/territory-rules.md \"Scoring at walk finish\"); sample uploads store raw data and answer a provisional filter result; ownership of hexagons never changes here (feature 004)."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token from POST /v1/auth/apple or /v1/auth/refresh (HS256, 15 minutes)"
      }
    },
    "schemas": {
      "Error": {
        "additionalProperties": false,
        "description": "Shared error envelope returned by every non-2xx response. `code` is a stable machine-readable identifier in SCREAMING_SNAKE_CASE; `message` is for developers, never shown verbatim to players; `details` carries validation issues or other structured context.",
        "type": "object",
        "required": ["error", "requestId"],
        "properties": {
          "error": {
            "additionalProperties": false,
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "pattern": "^[A-Z][A-Z0-9_]+$",
                "type": "string",
                "example": "VALIDATION_FAILED"
              },
              "message": { "type": "string" },
              "details": { "additionalProperties": true, "type": "object", "properties": {} }
            }
          },
          "requestId": {
            "description": "Fastify request id, also returned in the `x-request-id` response header",
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "additionalProperties": false,
        "type": "object",
        "required": ["status", "db", "version"],
        "properties": {
          "status": {
            "description": "ok when every dependency check passed",
            "type": "string",
            "enum": ["ok", "degraded"]
          },
          "db": {
            "description": "Result of `SELECT 1` against Postgres",
            "type": "string",
            "enum": ["ok", "error"]
          },
          "version": {
            "description": "API package version (from apps/api/package.json)",
            "type": "string"
          }
        }
      },
      "FactionStats": {
        "additionalProperties": false,
        "type": "object",
        "required": ["members", "activeMembers", "hexesOwnedR9", "hexesOwnedR7"],
        "properties": {
          "members": {
            "minimum": 0,
            "description": "Players with this faction, not deleted",
            "type": "integer"
          },
          "activeMembers": {
            "minimum": 0,
            "description": "Members who used the app within `activeWindowDays`",
            "type": "integer"
          },
          "hexesOwnedR9": { "minimum": 0, "type": "integer" },
          "hexesOwnedR7": { "minimum": 0, "type": "integer" }
        }
      },
      "Faction": {
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "slug", "name", "emoji", "colorLight", "colorDark", "sort", "stats"],
        "properties": {
          "id": { "type": "integer" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "emoji": { "type": "string" },
          "colorLight": { "pattern": "^#[0-9A-Fa-f]{6}$", "type": "string" },
          "colorDark": { "pattern": "^#[0-9A-Fa-f]{6}$", "type": "string" },
          "sort": { "type": "integer" },
          "stats": { "$ref": "#/components/schemas/FactionStats" }
        }
      },
      "FactionsResponse": {
        "additionalProperties": false,
        "type": "object",
        "required": ["factions", "suggestedFactionId", "activeWindowDays"],
        "properties": {
          "factions": {
            "description": "Sorted by `sort`, then `id`",
            "type": "array",
            "items": { "$ref": "#/components/schemas/Faction" }
          },
          "suggestedFactionId": {
            "description": "Faction with the fewest active members (tie → lowest id)",
            "type": "integer"
          },
          "activeWindowDays": {
            "description": "The window used for activeMembers (14)",
            "type": "integer"
          }
        }
      },
      "Me": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "displayName",
          "factionId",
          "factionChangedAt",
          "factionChangeAvailableAt",
          "xp",
          "level",
          "role",
          "createdAt",
          "suggestedFactionId"
        ],
        "properties": {
          "id": { "format": "uuid", "type": "string" },
          "displayName": { "type": "string" },
          "factionId": { "type": ["null", "integer"] },
          "factionChangedAt": { "format": "date-time", "type": ["null", "string"] },
          "factionChangeAvailableAt": {
            "format": "date-time",
            "description": "When the next faction change is allowed; null when a change is allowed now (or no faction is set yet)",
            "type": ["null", "string"]
          },
          "xp": { "minimum": 0, "type": "integer" },
          "level": { "minimum": 1, "type": "integer" },
          "role": { "type": "string", "enum": ["player", "tester", "admin"] },
          "createdAt": { "format": "date-time", "type": "string" },
          "suggestedFactionId": {
            "description": "Faction with the fewest active members (tie → lowest id)",
            "type": "integer"
          }
        }
      },
      "MeUpdate": {
        "additionalProperties": false,
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": {
            "minLength": 1,
            "maxLength": 64,
            "description": "Validated by the service to 2–24 Unicode scalars after trimming, no control characters",
            "type": "string"
          }
        }
      },
      "FactionSelect": {
        "additionalProperties": false,
        "type": "object",
        "required": ["factionId"],
        "properties": { "factionId": { "minimum": 1, "maximum": 32767, "type": "integer" } }
      },
      "AccountDeletion": {
        "additionalProperties": false,
        "type": "object",
        "required": ["deletedAt", "purgeAt"],
        "properties": {
          "deletedAt": { "format": "date-time", "type": "string" },
          "purgeAt": {
            "format": "date-time",
            "description": "When the erasure job runs (deletedAt + 30 days)",
            "type": "string"
          }
        }
      },
      "ExportStatus": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "status",
          "requestedAt",
          "completedAt",
          "expiresAt",
          "downloadUrl",
          "error"
        ],
        "properties": {
          "id": { "format": "uuid", "type": "string" },
          "status": { "type": "string", "enum": ["pending", "ready", "failed"] },
          "requestedAt": { "format": "date-time", "type": "string" },
          "completedAt": { "format": "date-time", "type": ["null", "string"] },
          "expiresAt": { "format": "date-time", "type": ["null", "string"] },
          "downloadUrl": {
            "description": "Presigned GET URL, valid for one hour; only when status is ready",
            "type": ["null", "string"]
          },
          "error": { "type": ["null", "string"] }
        }
      },
      "AuthAppleRequest": {
        "additionalProperties": false,
        "type": "object",
        "required": ["identityToken"],
        "properties": {
          "identityToken": {
            "minLength": 1,
            "maxLength": 8192,
            "description": "Apple identity token (JWT) from ASAuthorizationAppleIDCredential.identityToken",
            "type": "string"
          },
          "authorizationCode": {
            "minLength": 1,
            "maxLength": 2048,
            "description": "Apple authorization code; accepted and ignored in feature 002 (used by the token-revocation flow of feature 009)",
            "type": "string"
          },
          "fullName": {
            "additionalProperties": false,
            "description": "Present only on the first authorization, when Apple hands the name to the app",
            "type": "object",
            "properties": {
              "givenName": { "maxLength": 100, "type": "string" },
              "familyName": { "maxLength": 100, "type": "string" }
            }
          }
        }
      },
      "TokenPair": {
        "additionalProperties": false,
        "type": "object",
        "required": ["accessToken", "accessExpiresAt", "refreshToken", "refreshExpiresAt"],
        "properties": {
          "accessToken": { "type": "string" },
          "accessExpiresAt": { "format": "date-time", "type": "string" },
          "refreshToken": { "type": "string" },
          "refreshExpiresAt": { "format": "date-time", "type": "string" }
        }
      },
      "AuthResponse": {
        "additionalProperties": false,
        "type": "object",
        "required": ["tokens", "me", "isNewUser", "restored"],
        "properties": {
          "tokens": { "$ref": "#/components/schemas/TokenPair" },
          "me": { "$ref": "#/components/schemas/Me" },
          "isNewUser": { "type": "boolean" },
          "restored": {
            "description": "True when an account marked deleted was reactivated by this sign-in",
            "type": "boolean"
          }
        }
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "type": "object",
        "required": ["refreshToken"],
        "properties": { "refreshToken": { "minLength": 1, "maxLength": 256, "type": "string" } }
      },
      "LogoutRequest": {
        "additionalProperties": false,
        "type": "object",
        "required": ["refreshToken"],
        "properties": { "refreshToken": { "minLength": 1, "maxLength": 256, "type": "string" } }
      },
      "WalkCreateRequest": {
        "additionalProperties": false,
        "type": "object",
        "required": ["clientWalkId", "startedAt"],
        "properties": {
          "clientWalkId": {
            "format": "uuid",
            "description": "Generated on the device when the walk starts; the idempotency key",
            "type": "string"
          },
          "startedAt": { "format": "date-time", "type": "string" },
          "deviceInfo": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "model": { "maxLength": 64, "type": "string" },
              "osVersion": { "maxLength": 32, "type": "string" },
              "appVersion": { "maxLength": 32, "type": "string" }
            }
          }
        }
      },
      "WalkCreated": {
        "additionalProperties": false,
        "type": "object",
        "required": ["walkId", "clientWalkId", "startedAt", "status", "supersededWalkId"],
        "properties": {
          "walkId": { "format": "uuid", "type": "string" },
          "clientWalkId": { "format": "uuid", "type": "string" },
          "startedAt": { "format": "date-time", "description": "After clamping", "type": "string" },
          "status": {
            "description": "`active` for a new walk; when the clientWalkId already existed, the stored status of that walk",
            "type": "string",
            "enum": ["active", "finished", "flagged", "abandoned"]
          },
          "supersededWalkId": {
            "format": "uuid",
            "description": "The previously active walk that was auto-finished by this creation",
            "type": ["null", "string"]
          }
        }
      },
      "LocationSample": {
        "additionalProperties": false,
        "type": "object",
        "required": ["seq", "ts", "lat", "lon", "hAcc"],
        "properties": {
          "seq": { "minimum": 0, "type": "integer" },
          "ts": { "format": "date-time", "type": "string" },
          "lat": { "minimum": -90, "maximum": 90, "type": "number" },
          "lon": { "minimum": -180, "maximum": 180, "type": "number" },
          "hAcc": {
            "minimum": 0,
            "description": "Horizontal accuracy in metres",
            "type": "number"
          },
          "speed": {
            "minimum": 0,
            "description": "Device-reported speed in m/s",
            "type": ["number", "null"]
          },
          "course": { "minimum": 0, "maximum": 360, "type": ["number", "null"] },
          "alt": { "type": ["number", "null"] }
        }
      },
      "PedometerWindow": {
        "additionalProperties": false,
        "type": "object",
        "required": ["steps", "since", "until"],
        "properties": {
          "steps": { "minimum": 0, "type": "integer" },
          "since": { "format": "date-time", "type": "string" },
          "until": { "format": "date-time", "type": "string" }
        }
      },
      "SampleBatchRequest": {
        "additionalProperties": false,
        "type": "object",
        "required": ["samples"],
        "properties": {
          "samples": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": { "$ref": "#/components/schemas/LocationSample" }
          },
          "pedometer": { "$ref": "#/components/schemas/PedometerWindow" }
        }
      },
      "RejectedSample": {
        "additionalProperties": false,
        "type": "object",
        "required": ["seq", "reason"],
        "properties": {
          "seq": { "type": "integer" },
          "reason": { "type": "string", "enum": ["accuracy", "speed", "non_monotonic"] }
        }
      },
      "SampleBatchResult": {
        "additionalProperties": false,
        "type": "object",
        "required": ["stored", "duplicates", "accepted", "rejected", "sampleCount"],
        "properties": {
          "stored": {
            "minimum": 0,
            "description": "Rows inserted by this call",
            "type": "integer"
          },
          "duplicates": {
            "minimum": 0,
            "description": "Samples whose seq was already stored (ignored)",
            "type": "integer"
          },
          "accepted": {
            "description": "Provisionally accepted seqs among the stored rows",
            "type": "array",
            "items": { "type": "integer" }
          },
          "rejected": {
            "description": "Provisionally rejected seqs among the stored rows",
            "type": "array",
            "items": { "$ref": "#/components/schemas/RejectedSample" }
          },
          "sampleCount": {
            "minimum": 0,
            "description": "Total stored samples of the walk",
            "type": "integer"
          }
        }
      },
      "WalkFinishRequest": {
        "additionalProperties": false,
        "type": "object",
        "required": ["endedAt"],
        "properties": {
          "endedAt": { "format": "date-time", "type": "string" },
          "pedometerTotal": {
            "minimum": 0,
            "description": "Steps counted by the device during the walk; omitted when the pedometer is unavailable",
            "type": ["integer", "null"]
          }
        }
      },
      "WeekStanding": {
        "additionalProperties": false,
        "type": "object",
        "required": ["leader", "myFactionShare", "owner"],
        "properties": {
          "leader": {
            "description": "Faction with the highest (strength × 0.5 + this week's capped metres + bonuses); null when nobody has anything",
            "type": ["null", "integer"]
          },
          "myFactionShare": {
            "minimum": 0,
            "maximum": 1,
            "description": "The player's faction's share of this week's total score in the cell",
            "type": "number"
          },
          "owner": {
            "description": "Current owner from the last reckoning (informational; unchanged by walks)",
            "type": ["null", "integer"]
          }
        }
      },
      "WalkHex": {
        "additionalProperties": false,
        "type": "object",
        "required": ["h3", "meters", "cappedMeters", "weekStanding"],
        "properties": {
          "h3": { "pattern": "^[0-9a-f]{15}$", "type": "string" },
          "meters": {
            "minimum": 0,
            "description": "Raw metres of this walk's simplified path inside the cell",
            "type": "number"
          },
          "cappedMeters": {
            "minimum": 0,
            "description": "Metres of this walk that counted toward the player's 2 000 m weekly cap in the cell (0 when flagged)",
            "type": "number"
          },
          "weekStanding": { "$ref": "#/components/schemas/WeekStanding" }
        }
      },
      "LineString": {
        "additionalProperties": false,
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "enum": ["LineString"] },
          "coordinates": {
            "minItems": 2,
            "description": "GeoJSON positions [lon, lat]",
            "type": "array",
            "items": {
              "minItems": 2,
              "maxItems": 2,
              "type": "array",
              "items": { "type": "number" }
            }
          }
        }
      },
      "WalkSummary": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "walkId",
          "clientWalkId",
          "status",
          "finishReason",
          "startedAt",
          "endedAt",
          "finishedAt",
          "weekId",
          "distanceM",
          "durationS",
          "steps",
          "sampleCount",
          "hexCount",
          "xp",
          "scored",
          "flags",
          "hexes",
          "path"
        ],
        "properties": {
          "walkId": { "format": "uuid", "type": "string" },
          "clientWalkId": { "format": "uuid", "type": "string" },
          "status": { "type": "string", "enum": ["active", "finished", "flagged", "abandoned"] },
          "finishReason": {
            "type": ["null", "string"],
            "enum": ["client", "autofinish", "superseded", null]
          },
          "startedAt": { "format": "date-time", "type": "string" },
          "endedAt": { "format": "date-time", "type": ["null", "string"] },
          "finishedAt": { "format": "date-time", "type": ["null", "string"] },
          "weekId": { "pattern": "^[0-9]{4}-W[0-9]{2}$", "type": ["null", "string"] },
          "distanceM": { "minimum": 0, "type": "number" },
          "durationS": { "minimum": 0, "type": "integer" },
          "steps": { "type": ["null", "integer"] },
          "sampleCount": { "minimum": 0, "type": "integer" },
          "hexCount": { "minimum": 0, "type": "integer" },
          "xp": { "minimum": 0, "type": "integer" },
          "scored": {
            "description": "True when contributions and XP were written (false while active and for flagged walks)",
            "type": "boolean"
          },
          "flags": {
            "type": "array",
            "items": { "type": "string", "enum": ["teleport", "speed", "distance", "no_steps"] }
          },
          "hexes": {
            "description": "Sorted by h3 ascending; empty while active",
            "type": "array",
            "items": { "$ref": "#/components/schemas/WalkHex" }
          },
          "path": {
            "oneOf": [{ "$ref": "#/components/schemas/LineString" }, { "type": "null" }],
            "description": "Simplified accepted path; null while active or with fewer than two accepted samples"
          }
        }
      },
      "WalkListItem": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "walkId",
          "clientWalkId",
          "status",
          "finishReason",
          "startedAt",
          "endedAt",
          "weekId",
          "distanceM",
          "durationS",
          "hexCount",
          "xp",
          "scored",
          "flags"
        ],
        "properties": {
          "walkId": { "format": "uuid", "type": "string" },
          "clientWalkId": { "format": "uuid", "type": "string" },
          "status": { "type": "string", "enum": ["active", "finished", "flagged", "abandoned"] },
          "finishReason": {
            "type": ["null", "string"],
            "enum": ["client", "autofinish", "superseded", null]
          },
          "startedAt": { "format": "date-time", "type": "string" },
          "endedAt": { "format": "date-time", "type": ["null", "string"] },
          "weekId": { "type": ["null", "string"] },
          "distanceM": { "type": "number" },
          "durationS": { "type": "integer" },
          "hexCount": { "type": "integer" },
          "xp": { "type": "integer" },
          "scored": { "type": "boolean" },
          "flags": {
            "type": "array",
            "items": { "type": "string", "enum": ["teleport", "speed", "distance", "no_steps"] }
          }
        }
      },
      "WalkListPage": {
        "additionalProperties": false,
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/WalkListItem" } },
          "nextCursor": { "type": ["null", "string"] }
        }
      }
    }
  },
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "The OpenAPI 3.1 document describing this server",
        "tags": ["ops"],
        "description": "Generated at startup from the registered routes` TypeBox schemas. Snapshotted into packages/api-schema/openapi.json, from which the iOS client is generated.",
        "security": [],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "required": ["openapi", "info", "paths", "components"],
                  "properties": {
                    "openapi": { "pattern": "^3\\.1\\.\\d+$", "type": "string" },
                    "info": { "additionalProperties": true, "type": "object", "properties": {} },
                    "paths": { "additionalProperties": true, "type": "object", "properties": {} },
                    "components": {
                      "additionalProperties": true,
                      "type": "object",
                      "properties": {}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness and database readiness",
        "tags": ["ops"],
        "description": "Runs `SELECT 1` against Postgres with a 2 s timeout. Returns 200 when the database answers, 503 with `db: \"error\"` otherwise. Never requires authentication.",
        "responses": {
          "200": {
            "description": "API and database are reachable",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          },
          "503": {
            "description": "API is up but the database is not reachable",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        }
      }
    },
    "/v1/auth/apple": {
      "post": {
        "operationId": "signInWithApple",
        "summary": "Sign in (or up) with an Apple identity token",
        "tags": ["auth"],
        "description": "Verifies `identityToken` against Apple's JWKS (issuer `https://appleid.apple.com`, audience = the app's bundle identifier(s)), then creates or resumes the account keyed by Apple's `sub`. E-mail and `fullName` are stored only when the account is created; later calls ignore them. An account marked deleted within the last 30 days is restored (`restored: true`). Rate limited: 20 requests per minute per client address.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/AuthAppleRequest" } }
          }
        },
        "security": [],
        "responses": {
          "200": {
            "description": "Tokens for the (new or existing) account and the player's profile",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } }
            }
          },
          "400": {
            "description": "Request validation failed (code VALIDATION_FAILED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "The identity token is invalid (code INVALID_APPLE_TOKEN, `details.reason` in expired | audience | issuer | signature | malformed)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "429": {
            "description": "Too many requests from this client address (code RATE_LIMITED, `details.retryAfterS`); the `retry-after` header is set",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "503": {
            "description": "Apple's key service is unreachable (code APPLE_UNAVAILABLE); retry later",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refreshTokens",
        "summary": "Rotate a refresh token",
        "tags": ["auth"],
        "description": "Exchanges a valid refresh token for a new token pair and revokes the presented token. Presenting a token that was already rotated revokes every refresh token of the account (code REFRESH_REUSED). Rate limited: 20 requests per minute per client address.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } }
          }
        },
        "security": [],
        "responses": {
          "200": {
            "description": "New token pair",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TokenPair" } }
            }
          },
          "400": {
            "description": "Request validation failed (code VALIDATION_FAILED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Unknown, expired or revoked token (INVALID_REFRESH_TOKEN), reuse of a rotated token (REFRESH_REUSED), or deleted account (ACCOUNT_DELETED); the client must sign in again",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "429": {
            "description": "Too many requests from this client address (code RATE_LIMITED, `details.retryAfterS`); the `retry-after` header is set",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revoke the presented refresh token (sign out this device)",
        "tags": ["auth"],
        "description": "Revokes the refresh token if it belongs to the caller. Always succeeds for a valid session, even when the token is already revoked or unknown. Other devices are unaffected.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LogoutRequest" } }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Signed out" },
          "400": {
            "description": "Request validation failed (code VALIDATION_FAILED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "429": {
            "description": "Too many requests from this client address (code RATE_LIMITED, `details.retryAfterS`); the `retry-after` header is set",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/factions": {
      "get": {
        "operationId": "listFactions",
        "summary": "The three factions with live statistics and the suggested faction",
        "tags": ["factions"],
        "description": "No session required. Statistics are computed live: members and active members (used the app within `activeWindowDays`, not deleted, has a faction) from the player table, hexes owned at resolution 9 and 7 from the territory tables (zero until the first reckoning). `suggestedFactionId` is the faction with the fewest active members, ties broken by the lowest id. Sent with `Cache-Control: public, max-age=60`.",
        "security": [],
        "responses": {
          "200": {
            "description": "Factions sorted by `sort`, then `id`",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/FactionsResponse" } }
            }
          },
          "503": {
            "description": "Database not reachable (code DB_UNAVAILABLE)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "The signed-in player's profile",
        "tags": ["me"],
        "description": "Includes `suggestedFactionId` so the faction pick screen needs no second call. Never returns the e-mail address.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Profile",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateMe",
        "summary": "Update the display name",
        "tags": ["me"],
        "description": "The display name is trimmed, must be 2–24 Unicode scalars long and contain no control characters. Violations answer 400 VALIDATION_FAILED with `details.field = \"displayName\"` and `details.rule` in tooShort | tooLong | controlCharacter.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MeUpdate" } }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } }
          },
          "400": {
            "description": "Request validation failed (code VALIDATION_FAILED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMe",
        "summary": "Delete the account (30-day grace period)",
        "tags": ["me"],
        "description": "Marks the account deleted, revokes every refresh token and schedules erasure 30 days later (`account.purge`). Signing in with the same Apple ID before `purgeAt` restores the account. After this call every request with the old credentials answers 401 ACCOUNT_DELETED.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Deletion accepted",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AccountDeletion" } }
            }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/me/faction": {
      "post": {
        "operationId": "selectFaction",
        "summary": "Pick or change the faction",
        "tags": ["me"],
        "description": "The first pick is free and starts no lock. Re-selecting the current faction is a no-op. A change is allowed when the player has never changed or the previous change is at least 30 days old; otherwise 409 FACTION_CHANGE_LOCKED with `details.nextChangeAt`. XP and level are never altered.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/FactionSelect" } }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Updated profile (with `factionChangeAvailableAt` and `suggestedFactionId`)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } }
          },
          "400": {
            "description": "Request validation failed (code VALIDATION_FAILED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Unknown faction id (code FACTION_NOT_FOUND)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "Faction change locked (code FACTION_CHANGE_LOCKED, `details.nextChangeAt` ISO 8601)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/me/export": {
      "get": {
        "operationId": "getExport",
        "summary": "Request or poll the player's data export",
        "tags": ["me"],
        "description": "Returns the latest export when it is pending, ready and not older than 7 days (with a fresh `downloadUrl` valid for one hour), or failed less than a minute ago (so the failure is visible). Otherwise enqueues a new export (`account.export`) and answers 202 with `status: pending`. Clients poll every 5 seconds while pending.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Existing export (pending, ready or failed)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ExportStatus" } }
            }
          },
          "202": {
            "description": "A new export was enqueued",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ExportStatus" } }
            }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/walks": {
      "post": {
        "operationId": "createWalk",
        "summary": "Start a walk (idempotent on clientWalkId)",
        "tags": ["walks"],
        "description": "Creates the walk for `(player, clientWalkId)`; repeating the call returns the same walk with 200 (and its current status). `startedAt` is clamped to [now − 12 h, now + 5 min]. If the player has an active walk whose last activity precedes `startedAt`, that walk is finished automatically (`supersededWalkId`, reason `superseded`); if the ranges overlap the request is refused with 409 WALK_OVERLAP. Players without a faction cannot start walks (403 FACTION_REQUIRED). Rate limited: 20 creations per hour per player.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/WalkCreateRequest" } }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Walk already existed for this clientWalkId",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WalkCreated" } }
            }
          },
          "201": {
            "description": "Walk created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WalkCreated" } }
            }
          },
          "400": {
            "description": "Request validation failed (code VALIDATION_FAILED; `details.field` names the offending field, e.g. `samples` for a batch over 200 or `cursor` for a malformed cursor)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "403": {
            "description": "The player has no faction yet (code FACTION_REQUIRED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "Overlaps the player's active walk (code WALK_OVERLAP, `details.activeWalkId`)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "429": {
            "description": "Too many requests (code RATE_LIMITED, `details.retryAfterS`); the `retry-after` header is set",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "get": {
        "operationId": "listWalks",
        "summary": "The player's walks, newest first",
        "tags": ["walks"],
        "description": "Cursor pagination over the caller's own walks ordered by start time descending. `nextCursor` is opaque; pass it back to get the next page; null when exhausted. List items carry no path and no per-hex rows (use GET /v1/walks/{id}).",
        "parameters": [
          {
            "schema": { "maxLength": 200, "type": "string" },
            "in": "query",
            "name": "cursor",
            "required": false
          },
          {
            "schema": { "minimum": 1, "maximum": 50, "default": 20, "type": "integer" },
            "in": "query",
            "name": "limit",
            "required": false
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "One page",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WalkListPage" } }
            }
          },
          "400": {
            "description": "Request validation failed (code VALIDATION_FAILED; `details.field` names the offending field, e.g. `samples` for a batch over 200 or `cursor` for a malformed cursor)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/walks/{id}/samples": {
      "post": {
        "operationId": "uploadWalkSamples",
        "summary": "Upload a batch of raw location samples (store only)",
        "tags": ["walks"],
        "description": "Stores up to 200 samples idempotently by `(walk, seq)`: re-delivered or reordered batches never duplicate rows and never change the final score. The answer reports how many rows were new and a **provisional** result of the shared sample filter (accuracy > 50 m, speed > 5 m/s, non-monotonic timestamp); the finish step re-runs the filter over all stored samples. Nothing is scored here. Rate limited: 30 batches per 15 minutes per player (2 per minute average) and 8 640 stored samples per UTC day.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SampleBatchRequest" } }
          }
        },
        "parameters": [
          {
            "schema": { "format": "uuid", "type": "string" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Batch stored",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SampleBatchResult" } }
            }
          },
          "400": {
            "description": "Request validation failed (code VALIDATION_FAILED; `details.field` names the offending field, e.g. `samples` for a batch over 200 or `cursor` for a malformed cursor)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Unknown walk id or a walk that belongs to another player (code WALK_NOT_FOUND; never distinguishes the two)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "The walk is no longer active (code WALK_NOT_ACTIVE)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "429": {
            "description": "Batch rate limit (RATE_LIMITED) or daily sample quota (SAMPLE_QUOTA_EXCEEDED); `details.retryAfterS` and the `retry-after` header say how long to wait",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/walks/{id}/finish": {
      "post": {
        "operationId": "finishWalk",
        "summary": "Finish the walk and score it (the only scoring path)",
        "tags": ["walks"],
        "description": "In one transaction: re-run the sample filter over every stored sample, compute walk flags, simplify the accepted path (5 m), split it into resolution-9 cells, store the path and per-cell metres, set `weekId` to the ISO week (UTC) of the clamped end time (max(last accepted sample, min(endedAt, now))). Unflagged walks credit the player's faction per cell for the week (2 000 m cap per player per cell per week) and award 1 XP per 100 m (300 XP per day cap). Flagged walks store everything but credit nothing (`scored: false`, every `cappedMeters` 0, `xp` 0). Calling finish on an already finished walk returns the stored summary unchanged.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/WalkFinishRequest" } }
          }
        },
        "parameters": [
          {
            "schema": { "format": "uuid", "type": "string" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authoritative summary",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WalkSummary" } }
            }
          },
          "400": {
            "description": "Validation failed, or `endedAt` before `startedAt` (code INVALID_ENDED_AT)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Unknown walk id or a walk that belongs to another player (code WALK_NOT_FOUND; never distinguishes the two)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/walks/{id}": {
      "get": {
        "operationId": "getWalk",
        "summary": "One of the player's walks with its path and per-hex metres",
        "tags": ["walks"],
        "description": "Only the owner can read a walk; any other id answers 404 WALK_NOT_FOUND.",
        "parameters": [
          {
            "schema": { "format": "uuid", "type": "string" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Walk detail (same shape as the finish summary; `hexes` empty and `path` null while active)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WalkSummary" } }
            }
          },
          "401": {
            "description": "Missing or invalid access token (UNAUTHORIZED), expired token (TOKEN_EXPIRED) or deleted account (ACCOUNT_DELETED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Unknown walk id or a walk that belongs to another player (code WALK_NOT_FOUND; never distinguishes the two)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    }
  },
  "servers": [{ "url": "http://localhost:3000", "description": "Local development (make dev)" }],
  "tags": [
    { "name": "ops", "description": "Health and introspection" },
    {
      "name": "auth",
      "description": "Sign in with Apple, token refresh, logout (rate limited per client address)"
    },
    {
      "name": "factions",
      "description": "The three factions with live statistics and the suggested faction"
    },
    { "name": "me", "description": "The signed-in player's profile, faction, deletion and export" },
    {
      "name": "walks",
      "description": "Walk sessions of the signed-in player (paths are private to their owner)"
    }
  ]
}
