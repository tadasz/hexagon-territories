# OS / editors
.DS_Store
*.swp

# Node
node_modules/
dist/
.turbo/

# Python
__pycache__/
.venv/

# Xcode (project file is generated by XcodeGen)
apps/ios/*.xcodeproj
xcuserdata/
DerivedData/
*.xcworkspace/xcuserdata/

# Secrets
.env
.env.*
!.env.example

# Claude Code local state (skills in .claude/skills are committed on purpose)
.claude/settings.local.json

# Model weights are tracked with git-lfs; never commit raw binaries by accident
*.onnx
*.tflite
!ml/models/manifest.json
