# OS / editors
.DS_Store
*.swp

# Node
node_modules/
dist/
.turbo/
coverage/

# Python
__pycache__/
*.pyc
.venv/

# Xcode / SwiftPM (project file is generated by XcodeGen)
apps/ios/*.xcodeproj
apps/ios/.build/
apps/ios/Packages/*/.build/
apps/ios/Packages/*/.swiftpm/
*.xcresult
xcuserdata/
DerivedData/
*.xcworkspace/xcuserdata/

# Secrets
.env
.env.*
!.env.example

# Claude Code local state (skills in .claude/skills are committed on purpose)
.claude/settings.local.json
# Spec Kit machine-local state (.specify/feature.json) is covered by .specify/.gitignore

# Downloaded model weights (verified against ml/models/manifest.json)
ml/models/cache/

# Model weights are tracked with git-lfs (.gitattributes); never commit raw binaries by accident.
# The one LFS-tracked location is whitelisted below (T047 commits pointers there).
*.onnx
*.tflite
!apps/ios/Resources/Models/*.onnx
!apps/ios/Resources/Models/*.tflite
!ml/models/manifest.json
