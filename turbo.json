{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CI"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "SKIP_DB_TESTS",
    "TESTCONTAINERS_RYUK_DISABLED",
    "DOCKER_HOST",
    "JWT_SECRET",
    "APPLE_CLIENT_IDS",
    "APPLE_JWKS_URL",
    "S3_TEST",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_PUBLIC_ENDPOINT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
